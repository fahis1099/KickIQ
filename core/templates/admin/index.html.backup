{% extends "admin/index.html" %}

{% block content %}

<div style="
    margin-bottom: 25px;
    padding: 18px;
    background: #f8f9fa;
    border: 1px solid #ddd;
    border-radius: 6px;
">

    <h2 style="margin-top: 0;">
        KickIQ Tools
    </h2>

    <p>
        Manage and update KickIQ football data.
    </p>

    <a href="{% url 'admin:match-result-update' %}"
       class="button"
       style="
           display: inline-block;
           padding: 10px 16px;
           background: #417690;
           color: white;
           text-decoration: none;
           border-radius: 4px;
           font-weight: bold;
       ">
        ⚽ Match Result Update
    </a>

</div>

{{ block.super }}

{% endblock %}